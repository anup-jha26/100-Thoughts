<% if(success && success.length) { %>
    <div class="alert alert-success">
        <%= success %><span class="close-alert" onclick="this.parentElement.remove()">&times;</span>
    </div>
    <% } %>
        <% if(error && error.length) { %>
            <div class="alert alert-error">
                <%= error %><span class="close-alert" onclick="this.parentElement.remove()">&times;</span>
            </div>
            <% } %>