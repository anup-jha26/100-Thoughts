<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/css/style.css">
    <title>Edit Thought</title>
</head>

<body>
    <%- include('../includes/flash') %>
        <div class="form-container">
            <h1>Edit <%= thought.day %>
            </h1>
            <form action="/<%= thought._id %>?_method=PUT" method="POST">
                <div class="form-group"><label>Date</label><input type="text" name="thought[date]"
                        value="<%= thought.date %>"></div>
                <div class="form-group"><label>Thought</label><textarea
                        name="thought[text]"><%= thought.text %></textarea></div>
                <div class="form-group"><label>Admin Password</label><input type="password" name="adminPassword"
                        required></div>
                <button class="submit-btn">Update</button>
            </form>
            <a href="/">Cancel</a>
        </div>
</body>

</html>