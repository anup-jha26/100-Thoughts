<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Thought</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <header>
        <h1 style="font-size: 2.5rem; margin-bottom: 10px;">Edit Insight</h1>
    </header>

    <%- include('../includes/flash') %>

        <div class="glass-form-container">
            <form action="/<%= thought._id %>?_method=PUT" method="POST">
                <input type="text" name="thought[day]" value="<%= thought.day %>" required>
                <input type="text" name="thought[date]" value="<%= thought.date %>" required>
                <textarea name="thought[text]" required><%= thought.text %></textarea>
                <input type="password" name="adminPassword" placeholder="Admin Passcode to confirm" required>

                <button class="btn-primary" style="width: 100%; margin-top: 10px;">Update Insight</button>
            </form>
            <div style="text-align: center; margin-top: 20px;">
                <a href="/" class="btn-secondary" style="text-decoration: none;">Cancel & Go Back</a>
            </div>
        </div>
</body>

</html>