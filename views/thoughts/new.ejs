<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Thought</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <header>
        <h1 style="font-size: 2.5rem; margin-bottom: 10px;">New Insight</h1>
    </header>

    <%- include('../includes/flash') %>

        <div class="glass-form-container">
            <form action="/" method="POST">
                <input type="text" name="thought[day]" placeholder="E.g., Day 101" required>
                <input type="text" name="thought[date]" placeholder="E.g., Oct 24" required>
                <textarea name="thought[text]" placeholder="What is on your mind today?" required></textarea>
                <input type="password" name="adminPassword" placeholder="Admin Passcode" required>

                <button class="btn-primary" style="width: 100%; margin-top: 10px;">Save Insight</button>
            </form>
            <div style="text-align: center; margin-top: 20px;">
                <a href="/" class="btn-secondary" style="text-decoration: none;">Cancel & Go Back</a>
            </div>
        </div>
</body>

</html>