<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Thought</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../includes/flash') %>

        <header>
            <h1>Admin Panel</h1>
            <p class="desc">Add a new thought to the grid.</p>
        </header>

        <div class="form-container">
            <form action="/" method="POST">
                <div class="form-group">
                    <label for="day">Day Number</label>
                    <input type="text" id="day" name="thought[day]" placeholder="e.g., Day 102" required>
                </div>

                <div class="form-group">
                    <label for="date">Date</label>
                    <input type="text" id="date" name="thought[date]" placeholder="e.g., Apr 16" required>
                </div>

                <div class="form-group">
                    <label for="text">Thought / Quote</label>
                    <textarea id="text" name="thought[text]" placeholder="Enter the thought here..."
                        required></textarea>
                </div>

                <div class="form-group">
                    <label for="adminPass">Admin Secret Password</label>
                    <input type="password" id="adminPass" name="adminPassword" placeholder="Enter secret password"
                        required>
                </div>

                <button type="submit" class="submit-btn">Add Thought to Database</button>
            </form>

            <a href="/" class="back-link">← Back to Grid</a>
        </div>

</body>

</html>