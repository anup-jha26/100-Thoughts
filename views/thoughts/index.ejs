<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>100 Days of Thoughts</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../includes/flash') %>
        <header>
            <h1>100 Days of Thoughts</h1>
            <a href="/new" class="admin-link">+ New</a>
        </header>

        <main class="grid-container">
            <% for(let thought of allThoughts) { %>
                <div class="day-box" data-id="<%= thought._id %>" data-day="<%= thought.day %>"
                    data-date="<%= thought.date %>" data-text="<%= thought.text %>">
                    <%= thought.day %>
                </div>
                <% } %>
        </main>

        <div class="modal-overlay" id="modalOverlay">
            <div class="modal-content">
                <span class="modal-day" id="modalDayNumber"></span>
                <p class="modal-thought" id="modalThoughtText"></p>
                <div class="admin-actions">
                    <a id="editBtn" href="#" class="edit-link">Edit</a>
                    <form id="deleteForm" method="POST" onsubmit="return confirm('Delete permanently?')">
                        <input type="password" name="adminPassword" placeholder="Password" required>
                        <button class="delete-btn">Delete</button>
                    </form>
                </div>
                <button class="close-btn" id="closeBtn">Close</button>
            </div>
        </div>
        <script src="/js/script.js"></script>
</body>

</html>